TEXT 0 16 Left 3 ;Supplies: 12 V and two 5 V regulators
TEXT 1296 16 Left 3 ;Battery input and input-current sense
TEXT 2608 16 Left 3 ;Boost power stage and output banks
TEXT 0 1408 Left 3 ;LED channel 1 current regulator
TEXT 1120 1408 Left 3 ;LED channel 2 current regulator
TEXT 2240 1408 Left 3 ;LED channel 3 current regulator
TEXT 0 2048 Left 3 ;Gate driver: M1 (boost switch)
TEXT 1312 2048 Left 3 ;Gate driver: channel 1 switches M2/M7
TEXT 2624 2048 Left 3 ;Gate driver: channel 2 switches M3/M6
TEXT 3936 2048 Left 3 ;Gate driver: channel 3 switches M4/M5
TEXT 6112 16 Left 3 ;Arduino interface and LED-current references
TEXT 7632 16 Left 3 ;Channel sequencer and low-error timeout
TEXT 9264 16 Left 3 ;Error select and comparators
TEXT 6112 1504 Left 3 ;Channel 1 output-voltage error amplifier
TEXT 7504 1504 Left 3 ;Channel 2 output-voltage error amplifier
TEXT 8896 1504 Left 3 ;Channel 3 output-voltage error amplifier
TEXT 6112 2112 Left 3 ;Channel 1 reference sample-and-hold
TEXT 7360 2112 Left 3 ;Channel 2 reference sample-and-hold
TEXT 8608 2112 Left 3 ;Channel 3 reference sample-and-hold
TEXT 6112 2752 Left 3 ;Gate-enable logic and M1 inhibit
TEXT 8128 2752 Left 3 ;Logic supplies and spare gates
TEXT 0 4640 Left 3 ;Simulation test bench (LTspice only): battery, cable, LED loads, Arduino stimulus, directives
TEXT 0 -256 Left 4 ;BOOST LED driver - power board (left) and control card (right), one block per circuit; the KiCad sheets use the same arrangement
TEXT 3296 4720 Left 2 !.lib TLV9001.lib
TEXT 3296 4816 Left 2 !.ic V(Out)=0 V(Out-)=1 V(C10)=0 V(C5)=0 V(C2)=0
TEXT 3296 4912 Left 2 !.include MCP6561.lib
TEXT 3296 5008 Left 2 !.tran 30m startup uic
TEXT 3296 5104 Left 2 !.ic I(L1)=0 V(0A_hi)=5
TEXT 3296 5200 Left 2 !.lib CD4000_v.lib
TEXT 3296 5296 Left 2 !.lib HYG180N10.lib
TEXT 3296 5392 Left 2 !.options gmin=100f reltol=0.001
TEXT 3296 5488 Left 2 !.lib INA241A4.lib
TEXT 3296 5584 Left 2 !.model LED_RED   D(IS=1.18e-20 N=18 RS=3 CJO=2n)\n.model LED_GREEN D(IS=9.5e-25  N=22 RS=4 CJO=2n)\n.model LED_BLUE  D(IS=9.5e-25  N=22 RS=4 CJO=2n)
TEXT 3296 5808 Left 2 !.model 100W_LED_BLUE D(IS=1e-24 N=20.5 RS=0.8 CJO=2n)\n.model 100W_LED_RED D(IS=1e-23 N=14.5 RS=0.6 CJO=2n)\n.model 100W_LED_GREEN D(IS=1.5e-24 N=20.5 RS=0.9 CJO=2n)
TEXT 3296 6032 Left 2 !.lib L78L05.lib
TEXT 3296 6128 Left 2 !.lib MC7812.lib
TEXT 3296 6224 Left 2 !.meas TRAN Ptvs AVG  (-1)*V(LX)*I(D19) FROM 2m TO 13m\n.meas TRAN Etvs INTEG (-1)*V(LX)*I(D19)
TEXT 3296 6384 Left 2 ;.ic V(Vout_1)=30 V(Vout_2)=38 V(Vout_3)=30
TEXT 3296 6480 Left 2 !.ic V(SRV1)=2.89 V(SRV2)=3.86 V(SRV3)=3.86
TEXT 3296 6576 Left 2 !.ic V(Vref_1)=2 V(Vref_2)=3 V(Vref_3)=3
TEXT 3296 6672 Left 2 ;Start-up state: the two .ic lines above start the servos and reference filters settled.\nDelete both for a true cold start (about 0.5 s to full brightness).
TEXT 3296 6832 Left 2 !.lib CD74HC4066.lib\n.lib 74HC4051.lib\n.lib MCP4451.lib\n.lib CSS4J.lib\n.lib TVS_5p0SMDJ.lib\n.param IREF1_DUTY=256 IREF2_DUTY=256 IREF3_DUTY=256\n.param POT1_CODE=86 POT2_CODE=103 POT3_CODE=103
TEXT 3296 7312 Left 2 ;IREFn_DUTY: Arduino PWM duty on IREFn (J9) in 256ths, 490 Hz: 256 = always on, 128 = 50 %, 0 = off.\nPOTn_CODE: MCP4451 wiper code of U26A/B/C, 0-256 (0 = wiper at B = full current, 256 = at A = 0 A;
TEXT 3296 7472 Left 2 ;confirmed in Microchip's data sheet DS22267A). 86/103/103 give 2.63/2.37/2.37 A peaks.\nParts named SIM_ exist only in the simulation (battery, cable, LEDs, Arduino outputs).\nDimming runs (IREFn_DUTY below 256) can stop advancing while all LEDs are off (log fills with\n"tolerance relaxed" at one time). Adding solver=alt to the .options line got past it (2-3x slower).
TEXT 3296 7760 Left 2 !.model S2MW D(IS=14n RS=17m N=1.8 CJO=25p M=0.333 TT=3u BV=1000 IBV=5u)
TEXT 2608 1248 Left 2 ;D28-D30: pre-charge diodes Vin -> Vout_1/2/3
