* Library below included based on ModelFile attribute of instance X§U26E (C:\Users\bubba\AppData\Local\Temp\claude\C--Users-bubba-OneDrive-Documents-led-driver\a61b5f50-2814-4909-a59b-f34187a748dd\scratchpad\lt_run\MCP4451_CTRL.asy), X§U26A, X§U26B, X§U26C (C:\Users\bubba\AppData\Local\Temp\claude\C--Users-bubba-OneDrive-Documents-led-driver\a61b5f50-2814-4909-a59b-f34187a748dd\scratchpad\lt_run\MCP4451_POT.asy)
.lib MCP4451.lib
* Library below included based on ModelFile attribute of instance X§U10, X§U15, X§U19, X§U8 (C:\Users\bubba\AppData\Local\Temp\claude\C--Users-bubba-OneDrive-Documents-led-driver\a61b5f50-2814-4909-a59b-f34187a748dd\scratchpad\lt_run\UCC21520.asy)
.lib UCC21520.lib
.save V(vin) V(lx) V(vout_1) V(vout_2) V(vout_3) I(D19) I(SIM_LED1) I(SIM_LED2) I(SIM_LED3) V(srv1) V(srv2) V(srv3) V(Voltage_err_1) V(Voltage_err_2) V(Voltage_err_3) I(L1) V(12V) V(M1_ON) V(N013) V(Vref_1) V(.1Vref_1) V(gate_m1)
.meas TRAN LXmax MAX V(lx)
.backanno
B§VREF1G Vref_1_arduino 0 V=V(Vref_1_raw)*V(ard)
B§IREF1G IREF1 0 V=V(IREF1_raw)*V(ard)
B§VREF2G Vref_2_arduino 0 V=V(Vref_2_raw)*V(ard)
B§IREF2G IREF2 0 V=V(IREF2_raw)*V(ard)
B§VREF3G Vref_3_arduino 0 V=V(Vref_3_raw)*V(ard)
B§IREF3G IREF3 0 V=V(IREF3_raw)*V(ard)
V§ARD ard 0 PWL(0 1 15.3m 1 15.4m 0 30m 0 30.1m 1)

.SUBCKT LM2940_TSD IN OUT GND EN
* LM2940_12 with a thermal-shutdown enable: the output only sources current (a regulator in shutdown is high impedance)
BR n1 GND V=min(V(IN)-V(GND)-0.05, 12.0)*V(EN)
DO n1 n2 DSRC
RO n2 OUT 0.5
IQ IN GND 10m
.model DSRC D(Ron=1m Roff=100Meg Vfwd=0)
.ENDS LM2940_TSD
.meas TRAN LX_pre MAX V(lx) FROM 5m TO 15m
.meas TRAN LX_drop MAX V(lx) FROM 15m TO 25m
.meas TRAN LX_back MAX V(lx) FROM 25m TO 40m
.meas TRAN IL_drop MAX abs(I(L1)) FROM 15m TO 25m
.meas TRAN IL_back MAX abs(I(L1)) FROM 25m TO 40m
.meas TRAN E_drop INTEG (-1)*V(LX)*I(D19) FROM 15m TO 25m
.meas TRAN E_back INTEG (-1)*V(LX)*I(D19) FROM 25m TO 40m
.meas TRAN V12min MIN V(12V) FROM 15m TO 25m
.meas TRAN T_inh WHEN V(N013)=2.5 RISE=1 TD=15m
.meas TRAN ILED1_end AVG I(SIM_LED1) FROM 38m TO 40m
.meas TRAN ILED2_end AVG I(SIM_LED2) FROM 38m TO 40m
.meas TRAN ILED1_drop AVG I(SIM_LED1) FROM 20m TO 25m
.end
