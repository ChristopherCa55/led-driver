*==================================================================
*  BOOST full instrumentation - window 35m..39m
*  For a long servo run: change every "FROM 35m TO 39m"
*  to a window inside the settled region, and move the two
*  FIND ... AT times in section 5 to match.
*==================================================================
.ic V(N061)=2.89 V(N062)=3.86 V(N055)=3.90
*--- 1. CAPACITOR RIPPLE CURRENT, per capacitor -------------------
*    compare each against its Irms rating, then derate ~0.85 for
*    28 kHz vs the 100 kHz the rating is quoted at.
*    Also check caps within a bank share evenly.
* .meas TRAN Io2_C??   RMS I(C??)   FROM 35m TO 39m   <-- 3rd Vout_2 cap
*--- 2. RIPPLE VOLTAGE -------------------------------------------
*--- 3. POWER STAGE CURRENTS AND CONDUCTION LOSS ------------------
*--- 4. LX NODE AND TVS ------------------------------------------
*    VLX_max must stay well under the 100 V MOSFET BVDSS
*--- 5. CROSS-CONDUCTION (the safety check) ----------------------
*    (Removed: Dependencies on R62, R12, R24, R30 deleted)
*--- 6. BOOTSTRAP RAILS AND GATE DRIVE ---------------------------
*    Vbs*_min must stay above the 8 V driver UVLO
*--- 7. SUPPLY RAILS ---------------------------------------------
*--- 8. CONTROL LOOP HEALTH --------------------------------------
*    Verr_max is the one that matters: it must stay below the
*    INA's 4.98 V clip or RESET can never fire. Clip_marg compares
*    maxima from different cycles and channels, so treat it as
*    indicative only.
*--- 9. LED CURRENT, HEADROOM AND SINK DISSIPATION ---------------
*    Vds(sat) is 0.78 V at 2.63 A. Vhead*_min below that means the
*    sink drops into triode on ripple troughs and the LED dims.
*--- 10. POWER BALANCE -------------------------------------------
*--- 11. SERVO ---------------------------------------------------
*--- 12. TIMING (delete these two if LTspice complains) ----------
* Library below included based on ModelFile attribute of instance X§U1 (C:\Users\bubba\AppData\Local\Temp\claude\C--Users-bubba-OneDrive-Documents-led-driver\f541f33b-33a8-45e7-9198-b34885b80e4e\scratchpad\sim\INA241A3.asy)
.lib INA241A3.lib
* Library below included based on ModelFile attribute of instance X§U18, X§U17 (C:\Users\bubba\AppData\Local\Temp\claude\C--Users-bubba-OneDrive-Documents-led-driver\f541f33b-33a8-45e7-9198-b34885b80e4e\scratchpad\sim\L7805.asy)
.lib L7805.lib
* Library below included based on ModelFile attribute of instance X§U16 (C:\Users\bubba\AppData\Local\Temp\claude\C--Users-bubba-OneDrive-Documents-led-driver\f541f33b-33a8-45e7-9198-b34885b80e4e\scratchpad\sim\LM2940_12.asy)
.lib LM2940_12.lib
* Library below included based on ModelFile attribute of instance X§U10, X§U15, X§U19, X§U20 (C:\Users\bubba\AppData\Local\Temp\claude\C--Users-bubba-OneDrive-Documents-led-driver\f541f33b-33a8-45e7-9198-b34885b80e4e\scratchpad\sim\UCC21520.asy)
.lib UCC21520.lib
.SUBCKT HYG180N10_PROBE D G S Di Si Gi
LD D Di 4.5n
LS Si S 7.5n
LG G Gp 7.5n
Rg Gp Gi 2.38
Mcore Di Gi Si Si HYG180N10_CORE
Dbody Si Di HYG180N10_BODY
.MODEL HYG180N10_CORE NMOS(LEVEL=1 VTO=1.8 KP=8.6 LAMBDA=0.003 L=1 W=1
+ RS=1m RD=1m
+ CGSO=1583p CGDO=22.8p CBD=2.75n PB=0.7 MJ=0.5
+ IS=1e-20)
.MODEL HYG180N10_BODY D(IS=3e-11 N=1.0 RS=10m BV=100 IBV=1m CJO=0 TT=2.55n)
.ENDS HYG180N10_PROBE
.tran 0 40m 34.5m startup uic
.options plotwinsize=0
.save V(n026) V(n021) V(n035) V(n040) V(gate_m2) V(gate_m3) V(gate_m4) V(m1_gi) V(m2_gi) V(m3_gi) V(m4_gi) V(m2_si) V(m3_si) V(m4_si) I(Vsense_m1) V(gate_m1) V(lx) V(vout_1) V(vout_2) V(vout_3) V(m2_source) V(m3_source) V(m4_source) I(L1) I(D19) I(D16) I(D17) I(D18) V(v_err) I(Vsense_m2) I(Vsense_m3) I(Vsense_m4) V(m1_di) V(m1_si) V(m2_di) V(m2_si) V(m3_di) V(m3_si) V(m4_di) V(m4_si) V(m5_di) V(m5_si) V(m6_di) V(m6_si) V(m7_di) V(m7_si)
.meas TRAN IL_pk MAX abs(I(L1)) FROM 35m TO 39m
.meas TRAN Verr_max MAX V(V_err) FROM 35m TO 39m
.meas TRAN Vo1_avg AVG V(Vout_1) FROM 35m TO 39m
.meas TRAN Vo2_avg AVG V(Vout_2) FROM 35m TO 39m
.meas TRAN Vo3_avg AVG V(Vout_3) FROM 35m TO 39m
.meas TRAN Iled1_avg AVG I(D16) FROM 35m TO 39m
.meas TRAN Iled2_avg AVG I(D18) FROM 35m TO 39m
.meas TRAN Iled3_avg AVG I(D17) FROM 35m TO 39m
.meas TRAN VLX_max MAX V(LX) FROM 35m TO 39m
.meas TRAN VLX_min MIN V(LX) FROM 35m TO 39m
.meas TRAN Ptvs AVG -V(LX)*I(D19) FROM 35m TO 39m
.meas TRAN Etvs INTEG -V(LX)*I(D19) FROM 35m TO 39m
.meas TRAN Itvs_clamp MIN I(D19) FROM 35m TO 39m
.meas TRAN Itvs_pk MAX abs(I(D19)) FROM 35m TO 39m
.meas TRAN VdsPin_M2 MAX V(Vout_1,m2_source) FROM 35m TO 39m
.meas TRAN VdsPin_M3 MAX V(Vout_2,m3_source) FROM 35m TO 39m
.meas TRAN VdsPin_M4 MAX V(Vout_3,m4_source) FROM 35m TO 39m
.meas TRAN VdsPin_M7 MAX V(LX,m2_source) FROM 35m TO 39m
.meas TRAN VdsPin_M6 MAX V(LX,m3_source) FROM 35m TO 39m
.meas TRAN VdsPin_M5 MAX V(LX,m4_source) FROM 35m TO 39m
.meas TRAN Irev_M2 MAX I(Vsense_m2) FROM 35m TO 39m
.meas TRAN Irev_M3 MAX I(Vsense_m3) FROM 35m TO 39m
.meas TRAN Irev_M4 MAX I(Vsense_m4) FROM 35m TO 39m
.meas TRAN Qrev_M2 INTEG max(I(Vsense_m2),0) FROM 35m TO 39m
.meas TRAN Qrev_M3 INTEG max(I(Vsense_m3),0) FROM 35m TO 39m
.meas TRAN Qrev_M4 INTEG max(I(Vsense_m4),0) FROM 35m TO 39m
.meas TRAN VdsDie_M1 MAX V(m1_di,m1_si) FROM 35m TO 39m
.meas TRAN VdsDie_M2 MAX V(m2_di,m2_si) FROM 35m TO 39m
.meas TRAN VdsDie_M3 MAX V(m3_di,m3_si) FROM 35m TO 39m
.meas TRAN VdsDie_M4 MAX V(m4_di,m4_si) FROM 35m TO 39m
.meas TRAN VdsDie_M5 MAX V(m5_di,m5_si) FROM 35m TO 39m
.meas TRAN VdsDie_M6 MAX V(m6_di,m6_si) FROM 35m TO 39m
.meas TRAN VdsDie_M7 MAX V(m7_di,m7_si) FROM 35m TO 39m
.meas TRAN VLS_M1 MAX abs(V(m1_si)) FROM 35m TO 39m
.meas TRAN didt_M1 PARAM VLS_M1/7.5n
.end

