	)
	(text "confirmed in Microchip's data sheet DS22267A). 86/103/103 give 2.63/2.37/2.37 A peaks.\nParts named SIM_ exist only in the simulation (battery, cable, LEDs, Arduino outputs).\nDimming runs (IREFn_DUTY below 256) can stop advancing while all LEDs are off (log fills with\n\"tolerance relaxed\" at one time). Adding solver=alt to the .options line got past it (2-3x slower)."
		(exclude_from_sim no)
		(at 122.555 591.185 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a22a550e-613b-4cf0-8df5-e4920fe8b2bc")
	)
