.meas TRAN LXss MAX V(LX) FROM 25m TO 30m
.meas TRAN ID19min MIN I(D19) FROM 25m TO 30m
.meas TRAN Ptvs_ss AVG (-1)*V(LX)*I(D19) FROM 25m TO 30m
.meas TRAN IL1avg AVG I(L1) FROM 25m TO 30m
