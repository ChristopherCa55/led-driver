.save V(LX) I(D19) V(Vin) V(Vout_1) V(Vout_2) V(Vout_3) I(SIM_LED1) I(SIM_LED2) I(SIM_LED3) I(L1) V(12V) V(5V) V(SRV1) V(SRV2) V(SRV3) V(Verr1) V(Verr2) V(Verr3) V(Out) V(Out-) V(Vref_1) V(Vref_2) V(Vref_3) V(Output1_drain) V(Output2_drain) V(Output3_drain) V(m2_source) V(m3_source) V(m4_source)
.options plotwinsize=0
.meas TRAN ILED1 AVG I(SIM_LED1) FROM 25m TO 30m
.meas TRAN ILED2 AVG I(SIM_LED2) FROM 25m TO 30m
.meas TRAN ILED3 AVG I(SIM_LED3) FROM 25m TO 30m
