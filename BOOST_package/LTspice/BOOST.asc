TEXT -2880 1960 Left 2 !.model AGATE SW(Ron=70 Roff=1e12 Vt=2.5 Vh=0.5)
TEXT -2880 2072 Left 2 !*==================================================================\n*  BOOST full instrumentation - window 35m..39m\n*  For a long servo run: change every "FROM 35m TO 39m"\n*  to a window inside the settled region, and move the two\n*  FIND ... AT times in section 5 to match.\n*==================================================================\n \n.ic V(N064)=2.7 V(N065)=3.7 V(N058)=3.7\n \n*--- 1. CAPACITOR RIPPLE CURRENT, per capacitor -------------------\n*    compare each against its Irms rating, then derate ~0.85 for\n*    28 kHz vs the 100 kHz the rating is quoted at.\n*    Also check caps within a bank share evenly.\n.meas TRAN Iin_C40   RMS I(C40)   FROM 35m TO 39m\n.meas TRAN Iin_C69   RMS I(C69)   FROM 35m TO 39m\n.meas TRAN Iin_C85   RMS I(C85)   FROM 35m TO 39m\n.meas TRAN Io1_C70   RMS I(C70)   FROM 35m TO 39m\n.meas TRAN Io1_C86   RMS I(C86)   FROM 35m TO 39m\n.meas TRAN Io2_C71   RMS I(C71)   FROM 35m TO 39m\n.meas TRAN Io2_C78   RMS I(C78)   FROM 35m TO 39m\n* .meas TRAN Io2_C??   RMS I(C??)   FROM 35m TO 39m   <-- 3rd Vout_2 cap\n.meas TRAN Io3_C74   RMS I(C74)   FROM 35m TO 39m\n.meas TRAN Io3_C75   RMS I(C75)   FROM 35m TO 39m\n.meas TRAN Io3_C77   RMS I(C77)   FROM 35m TO 39m\n.meas TRAN Iin_cer   RMS I(C79)   FROM 35m TO 39m\n.meas TRAN Io1_cer   RMS I(C1)    FROM 35m TO 39m\n \n*--- 2. RIPPLE VOLTAGE -------------------------------------------\n.meas TRAN Vin_avg   AVG V(Vin)     FROM 35m TO 39m\n.meas TRAN Vin_pp    PP  V(Vin)     FROM 35m TO 39m\n.meas TRAN Vin_min   MIN V(Vin)     FROM 35m TO 39m\n.meas TRAN Vo1_avg   AVG V(Vout_1)  FROM 35m TO 39m\n.meas TRAN Vo1_pp    PP  V(Vout_1)  FROM 35m TO 39m\n.meas TRAN Vo2_avg   AVG V(Vout_2)  FROM 35m TO 39m\n.meas TRAN Vo2_pp    PP  V(Vout_2)  FROM 35m TO 39m\n.meas TRAN Vo3_avg   AVG V(Vout_3)  FROM 35m TO 39m\n.meas TRAN Vo3_pp    PP  V(Vout_3)  FROM 35m TO 39m\n \n*--- 3. POWER STAGE CURRENTS AND CONDUCTION LOSS ------------------\n.meas TRAN IL_pk     MAX abs(I(L1))          FROM 35m TO 39m\n.meas TRAN IL_rms    RMS I(L1)               FROM 35m TO 39m\n.meas TRAN IL_avg    AVG abs(I(L1))          FROM 35m TO 39m\n.meas TRAN P_L1      AVG I(L1)*I(L1)*1.6m    FROM 35m TO 39m\n.meas TRAN P_R1shunt AVG I(R1)*I(R1)*2m      FROM 35m TO 39m\n \n*--- 4. LX NODE AND TVS ------------------------------------------\n*    VLX_max must stay well under the 100 V MOSFET BVDSS\n.meas TRAN VLX_max   MAX V(LX)                    FROM 35m TO 39m\n.meas TRAN VLX_min   MIN V(LX)                    FROM 35m TO 39m\n.meas TRAN Itvs_pk   MAX abs(I(D19))              FROM 35m TO 39m\n.meas TRAN Ptvs_ss   AVG (-1)*V(LX)*I(D19)        FROM 35m TO 39m\n.meas TRAN Etvs_all  INTEG (-1)*V(LX)*I(D19)\n \n*--- 5. CROSS-CONDUCTION (the safety check) ----------------------\n*    (Removed: Dependencies on R62, R12, R24, R30 deleted)\n \n*--- 6. BOOTSTRAP RAILS AND GATE DRIVE ---------------------------\n*    Vbs*_min must stay above the 8 V driver UVLO\n.meas TRAN Vbs1_min  MIN V(N020,m2_source) FROM 35m TO 39m\n.meas TRAN Vbs2_min  MIN V(N041,m3_source) FROM 35m TO 39m\n.meas TRAN Vbs3_min  MIN V(N053,m4_source) FROM 35m TO 39m\n.meas TRAN Vg_M1max  MAX V(GATE_M1)                 FROM 35m TO 39m\n.meas TRAN Vg_M2max  MAX V(GATE_M2,m2_source)       FROM 35m TO 39m\n.meas TRAN Vg_M7max  MAX V(GATE_M7,m2_source)       FROM 35m TO 39m\n.meas TRAN Vg_M3max  MAX V(GATE_M3,m3_source)       FROM 35m TO 39m\n.meas TRAN Vg_M6max  MAX V(GATE_M6,m3_source)       FROM 35m TO 39m\n.meas TRAN Vg_M4max  MAX V(GATE_M4,m4_source)       FROM 35m TO 39m\n.meas TRAN Vg_M5max  MAX V(GATE_M5,m4_source)       FROM 35m TO 39m\n.meas TRAN Ibs1_avg  AVG I(D10)  FROM 35m TO 39m\n.meas TRAN Ibs2_avg  AVG I(D9)   FROM 35m TO 39m\n.meas TRAN Ibs3_avg  AVG I(D21)  FROM 35m TO 39m\n \n*--- 7. SUPPLY RAILS ---------------------------------------------\n.meas TRAN V12_avg   AVG V(12V)        FROM 35m TO 39m\n.meas TRAN V12_min   MIN V(12V)        FROM 35m TO 39m\n.meas TRAN VDD_min   MIN V(VDD)        FROM 35m TO 39m\n.meas TRAN VDD_pp    PP  V(VDD)        FROM 35m TO 39m\n.meas TRAN Va5_min   MIN V(analog_5V)  FROM 35m TO 39m\n.meas TRAN Va5_pp    PP  V(analog_5V)  FROM 35m TO 39m\n.meas TRAN Vpg_avg   AVG V(N013)       FROM 35m TO 39m\n \n*--- 8. CONTROL LOOP HEALTH --------------------------------------\n*    Verr_max is the one that matters: it must stay below the\n*    INA's 4.98 V clip or RESET can never fire. Clip_marg compares\n*    maxima from different cycles and channels, so treat it as\n*    indicative only.\n.meas TRAN Verr_max  MAX V(V_err)    FROM 35m TO 39m\n.meas TRAN Isns_max  MAX V(Current)  FROM 35m TO 39m\n.meas TRAN Clip_marg PARAM Isns_max-Verr_max\n.meas TRAN Verr1_avg AVG V(Verr1)    FROM 35m TO 39m\n.meas TRAN Verr2_avg AVG V(Verr2)    FROM 35m TO 39m\n.meas TRAN Verr3_avg AVG V(Verr3)    FROM 35m TO 39m\n.meas TRAN Vtimeout  AVG V(low_error_timeout) FROM 35m TO 39m\n \n*--- 9. LED CURRENT, HEADROOM AND SINK DISSIPATION ---------------\n*    Vds(sat) is 0.78 V at 2.63 A. Vhead*_min below that means the\n*    sink drops into triode on ripple troughs and the LED dims.\n.meas TRAN Iled1_avg AVG I(D16) FROM 35m TO 39m\n.meas TRAN Iled1_pp  PP  I(D16) FROM 35m TO 39m\n.meas TRAN Iled2_avg AVG I(D18) FROM 35m TO 39m\n.meas TRAN Iled2_pp  PP  I(D18) FROM 35m TO 39m\n.meas TRAN Iled3_avg AVG I(D17) FROM 35m TO 39m\n.meas TRAN Iled3_pp  PP  I(D17) FROM 35m TO 39m\n.meas TRAN Vhead1min MIN V(Output1_drain,N023) FROM 35m TO 39m\n.meas TRAN Vhead1avg AVG V(Output1_drain,N023) FROM 35m TO 39m\n.meas TRAN Vhead2min MIN V(Output2_drain,N033) FROM 35m TO 39m\n.meas TRAN Vhead2avg AVG V(Output2_drain,N033) FROM 35m TO 39m\n.meas TRAN Vhead3min MIN V(Output3_drain,N045) FROM 35m TO 39m\n.meas TRAN Vhead3avg AVG V(Output3_drain,N045) FROM 35m TO 39m\n.meas TRAN Psink1    AVG V(Output1_drain,N023)*I(D16) FROM 35m TO 39m\n.meas TRAN Psink2    AVG V(Output2_drain,N033)*I(D18) FROM 35m TO 39m\n.meas TRAN Psink3    AVG V(Output3_drain,N045)*I(D17) FROM 35m TO 39m\n.meas TRAN Pled1     AVG V(Vout_1,Output1_drain)*I(D16) FROM 35m TO 39m\n.meas TRAN Pled2     AVG V(Vout_2,Output2_drain)*I(D18) FROM 35m TO 39m\n.meas TRAN Pled3     AVG V(Vout_3,Output3_drain)*I(D17) FROM 35m TO 39m\n.meas TRAN Pshunt1   AVG I(R52)*I(R52)*0.05 FROM 35m TO 39m\n \n*--- 10. POWER BALANCE -------------------------------------------\n.meas TRAN Pin       AVG (-1)*V(P001)*I(V1)     FROM 35m TO 39m\n.meas TRAN Pcable    AVG I(R99)*I(R99)*0.012    FROM 35m TO 39m\n.meas TRAN Pled_tot  PARAM Pled1+Pled2+Pled3\n.meas TRAN Psink_tot PARAM Psink1+Psink2+Psink3\n.meas TRAN Eff_led   PARAM Pled_tot/Pin\n \n*--- 11. SERVO ---------------------------------------------------\n.meas TRAN Vsrv1_avg AVG V(N064) FROM 35m TO 39m\n.meas TRAN Vsrv2_avg AVG V(N065) FROM 35m TO 39m\n.meas TRAN Vsrv3_avg AVG V(N058) FROM 35m TO 39m\n.meas TRAN Vsmp1_avg AVG V(N062) FROM 35m TO 39m\n.meas TRAN Vsmp2_avg AVG V(N063) FROM 35m TO 39m\n.meas TRAN Vsmp3_avg AVG V(N057) FROM 35m TO 39m\n \n*--- 12. TIMING (delete these two if LTspice complains) ----------\n.meas TRAN T_round TRIG V(OUT_1_ENA) VAL=2.5 RISE=1 TD=35m TARG V(OUT_1_ENA) VAL=2.5 RISE=2 TD=35m\n.meas TRAN T_M1on  TRIG V(GATE_M1) VAL=6 RISE=1 TD=35m TARG V(GATE_M1) VAL=6 FALL=1 TD=35m
